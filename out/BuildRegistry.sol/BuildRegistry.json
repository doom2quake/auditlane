"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"deployedBytecodeHash\",\"type\":\"bytes32\"},{\"internalType\":\"bool\",\"name\":\"hasDeployment\",\"type\":\"bool\"},{\"internalType\":\"bool\",\"name\":\"sourcePresent\",\"type\":\"bool\"}],\"internalType\":\"struct BuildRegistry.ContractEntry[]\",\"name\":\"contracts\",\"type\":\"tuple[]\"}],\"internalType\":\"struct BuildRegistry.Package\",\"name\":\"p\",\"type\":\"tuple\"}],\"name\":\"check\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"ok\",\"type\":\"bool\"},{\"internalType\":\"uint16\",\"name\":\"code\",\"type\":\"uint16\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"manifestId\",\"type\":\"bytes32\"},{\"components\":[{\"internalType\":\"bool\",\"name\":\"toolchainPinned\",\"type\":\"bool\"},{\"internalType\":\"bool\",\"name\":\"hasSources\",\"type\":\"bool\"},{\"internalType\":\"uint256\",\"name\":\"testsPassed\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"testsFailed\",\"type\":\"uint256\"},{\"components\":[{\"internalType\":\"bytes32\",\"name\":\"artifactBytecodeHash\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"deployedBytecodeHash\",\"type\":\"bytes32\"},{\"internalType\":\"bool\",\"name\":\"hasDeployment\",\"type\":\"bool\"},{\"internalType\":\"bool\",\"name\":\"sourcePresent\",\"type\":\"bool\"}],\"internalType\":\"struct BuildRegistry.ContractEntry[]\",\"name\":\"contracts\",\"type\":\"tuple[]\"}],\"internalType\":\"struct BuildRegistry.Package\",\"name\":\"p\",\"type\":\"tuple\"}],\"name\":\"commit\",\"outputs\":[{\"internalType\":\"uint16\",\"name\":\"code\",\"type\":\"uint16\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"name\":\"committedAt\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"name\":\"committedBy\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes\",\"name\":\"canonicalPayload\",\"type\":\"bytes\"}],\"name\":\"manifestDigest\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"owner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint16\",\"name\":\"code\",\"type\":\"uint16\"}],\"name\":\"reasonFor\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}],\"stateMutability\":\"pure\",\"type\":\"function\"}],\"devdoc\":{\"author\":\"Dipankar Sarkar\",\"kind\":\"dev\",\"methods\":{},\"title\":\"BuildRegistry \\u2014 an on-chain commitment to a reproducible pre-audit package\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"check((bool,bool,uint256,uint256,(bytes32,bytes32,bool,bool)[]))\":{\"notice\":\"Deterministic reproducibility check. Returns (ok, firstCode). The order         of checks is FIXED and identical to auditlane/manifest.check, so the         returned first-failing code is stable and matches the off-chain verdict.\"},\"commit(bytes32,(bool,bool,uint256,uint256,(bytes32,bytes32,bool,bool)[]))\":{\"notice\":\"Commit a manifest id on-chain with its computed verdict. A commitment is         write-once: re-committing the same id reverts, so a package's claim is         immutable once made.\"},\"manifestDigest(bytes)\":{\"notice\":\"Recompute a manifest's content-addressed id from a canonical payload.         The caller passes the exact canonical payload the off-chain builder         hashed (auditlane/manifest._canonical_payload). This contract commits to         the id, so a published package can be checked against the on-chain claim.\"}},\"notice\":\"AuditLane folds an Arbitrum repo into a content-addressed manifest: a         pinned toolchain, captured test counts, and every contract's source hash         and deployed-bytecode hash. This contract is the on-chain side of that         package. `manifestDigest` recomputes the manifest id from its fields with         the SAME field order and canonical joining as the off-chain         `auditlane.manifest`, so a project can COMMIT a manifest id on Arbitrum         Sepolia and anyone can recompute it from the published package and check         the two agree. The reproducibility verdict is likewise a pure, deterministic         function of the package, so a firm never has to trust our word for it \\u2014 the         reason codes and their fixed order are the same in Solidity and in Python.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/BuildRegistry.sol\":\"BuildRegistry\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"src/BuildRegistry.sol\":{\"keccak256\":\"0xe34b8f73b6ee9347fa6e3694195a9ace9e1877fc76693f12b6f9887b0dfe2f56\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://4a954daa508f99ec9b6810a332e21ab8bad3482c31f0ca26de33e197f7de84f3\",\"dweb:/ipfs/QmNuokhWfcaPFPBsj6ScCcmeakUbFus7NNhXQd7NbMZyL3\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.24+commit.e11b9ed9"},"language":"Solidity","output":{"abi":[{"inputs":[],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[{"internalType":"bytes32","name":"manifestId","type":"bytes32"}],"type":"error","name":"AlreadyCommitted"},{"inputs":[{"internalType":"bytes32","name":"manifestId","type":"bytes32","indexed":true},{"internalType":"address","name":"by","type":"address","indexed":true},{"internalType":"uint16","name":"verdict","type":"uint16","indexed":false}],"type":"event","name":"ManifestCommitted","anonymous":false},{"inputs":[{"internalType":"struct BuildRegistry.Package","name":"p","type":"tuple","components":[{"internalType":"bool","name":"toolchainPinned","type":"bool"},{"internalType":"bool","name":"hasSources","type":"bool"},{"internalType":"uint256","name":"testsPassed","type":"uint256"},{"internalType":"uint256","name":"testsFailed","type":"uint256"},{"internalType":"struct BuildRegistry.ContractEntry[]","name":"contracts","type":"tuple[]","components":[{"internalType":"bytes32","name":"artifactBytecodeHash","type":"bytes32"},{"internalType":"bytes32","name":"deployedBytecodeHash","type":"bytes32"},{"internalType":"bool","name":"hasDeployment","type":"bool"},{"internalType":"bool","name":"sourcePresent","type":"bool"}]}]}],"stateMutability":"pure","type":"function","name":"check","outputs":[{"internalType":"bool","name":"ok","type":"bool"},{"internalType":"uint16","name":"code","type":"uint16"}]},{"inputs":[{"internalType":"bytes32","name":"manifestId","type":"bytes32"},{"internalType":"struct BuildRegistry.Package","name":"p","type":"tuple","components":[{"internalType":"bool","name":"toolchainPinned","type":"bool"},{"internalType":"bool","name":"hasSources","type":"bool"},{"internalType":"uint256","name":"testsPassed","type":"uint256"},{"internalType":"uint256","name":"testsFailed","type":"uint256"},{"internalType":"struct BuildRegistry.ContractEntry[]","name":"contracts","type":"tuple[]","components":[{"internalType":"bytes32","name":"artifactBytecodeHash","type":"bytes32"},{"internalType":"bytes32","name":"deployedBytecodeHash","type":"bytes32"},{"internalType":"bool","name":"hasDeployment","type":"bool"},{"internalType":"bool","name":"sourcePresent","type":"bool"}]}]}],"stateMutability":"nonpayable","type":"function","name":"commit","outputs":[{"internalType":"uint16","name":"code","type":"uint16"}]},{"inputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"stateMutability":"view","type":"function","name":"committedAt","outputs":[{"internalType":"uint256","name":"","type":"uint256"}]},{"inputs":[{"internalType":"bytes32","name":"","type":"bytes32"}],"stateMutability":"view","type":"function","name":"committedBy","outputs":[{"internalType":"address","name":"","type":"address"}]},{"inputs":[{"internalType":"bytes","name":"canonicalPayload","type":"bytes"}],"stateMutability":"pure","type":"function","name":"manifestDigest","outputs":[{"internalType":"bytes32","name":"","type":"bytes32"}]},{"inputs":[],"stateMutability":"view","type":"function","name":"owner","outputs":[{"internalType":"address","name":"","type":"address"}]},{"inputs":[{"internalType":"uint16","name":"code","type":"uint16"}],"stateMutability":"pure","type":"function","name":"reasonFor","outputs":[{"internalType":"string","name":"","type":"string"}]}],"devdoc":{"kind":"dev","methods":{},"version":1},"userdoc":{"kind":"user","methods":{"check((bool,bool,uint256,uint256,(bytes32,bytes32,bool,bool)[]))":{"notice":"Deterministic reproducibility check. Returns (ok, firstCode). The order         of checks is FIXED and identical to auditlane/manifest.check, so the         returned first-failing code is stable and matches the off-chain verdict."},"commit(bytes32,(bool,bool,uint256,uint256,(bytes32,bytes32,bool,bool)[]))":{"notice":"Commit a manifest id on-chain with its computed verdict. A commitment is         write-once: re-committing the same id reverts, so a package's claim is         immutable once made."},"manifestDigest(bytes)":{"notice":"Recompute a manifest's content-addressed id from a canonical payload.         The caller passes the exact canonical payload the off-chain builder         hashed (auditlane/manifest._canonical_payload). This contract commits to         the id, so a published package can be checked against the on-chain claim."}},"version":1}},"settings":{"remappings":[],"optimizer":{"enabled":true,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"src/BuildRegistry.sol":"BuildRegistry"},"evmVersion":"cancun","libr